#!/usr/bin/env bash
# Chan push truc tiep len develop/main (lop 2 branch guard). Bo qua co y: ALLOW_PROTECTED_PUSH=1 git push ...
[ "${ALLOW_PROTECTED_PUSH:-0}" = "1" ] && exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/develop|refs/heads/main)
      echo "pre-push: push truc tiep len ${remote_ref#refs/heads/} bi chan. Mo PR thay vi push. (ALLOW_PROTECTED_PUSH=1 de bo qua co y)" >&2
      exit 1 ;;
  esac
done
exit 0
